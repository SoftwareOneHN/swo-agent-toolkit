{
  "name": "swo-agent-toolkit",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"],
    "overrides": {
      "lodash": "npm:lodash-es@^4.17.21",
      "path-to-regexp": ">=8.4.2",
      "ip-address": ">=10.2.0",
      "hono": ">=4.12.18",
      "fast-uri": ">=3.1.2",
      "picomatch": ">=4.0.4",
      "serialize-javascript": ">=7.0.5",
      "qs": ">=6.15.2",
      "vite": ">=7.3.2",
      "postcss": ">=8.5.10",
      "minimatch@10>brace-expansion": ">=5.0.6"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @swohn/cli dev",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "lint:check": "pnpm -r lint:check",
    "test": "pnpm -r test",
    "cli:build": "pnpm --filter @swohn/cli build",
    "cli:dev": "pnpm --filter @swohn/cli dev",
    "mcp:build": "pnpm --filter @swohn/mcp build",
    "mcp:dev": "pnpm --filter @swohn/mcp dev",
    "mcp:test": "pnpm --filter @swohn/mcp test",
    "memory:build": "pnpm --filter @swohn/memory build",
    "memory:dev": "pnpm --filter @swohn/memory dev",
    "memory:test": "pnpm --filter @swohn/memory test",
    "server:build": "pnpm --filter @swohn/server build",
    "server:dev": "pnpm --filter @swohn/server start:dev",
    "release:cli": "tsx tools/scripts/release-cli.ts",
    "release:mcp": "tsx tools/scripts/release-mcp.ts",
    "release:memory": "tsx tools/scripts/release-memory.ts",
    "release:server": "tsx tools/scripts/release-server.ts",
    "release:skills": "tsx tools/scripts/release-all-skills.ts",
    "benchmark": "tsx tools/scripts/benchmark/index.ts",
    "benchmark:report": "tsx tools/scripts/benchmark/index.ts --report-only",
    "generate-indices": "tsx tools/scripts/generate-indices.ts",
    "audit:skills": "tsx tools/scripts/audit-skills.ts",
    "audit:sdlc": "tsx tools/scripts/audit-sdlc.ts",
    "audit:injection": "tsx tools/scripts/scan-injection.ts",
    "check-alignment": "tsx tools/scripts/check-alignment.ts",
    "calculate-tokens": "tsx tools/scripts/calculate-tokens.ts",
    "test:e2e": "tsx tools/scripts/test-e2e.ts",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.30",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fs-extra": "^11.3.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "inquirer": "^9.3.7",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  }
}
